rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read/write their own profile document.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Reports are publicly readable (the community feed requires no
    // account to be transparent about what's already reported), but only
    // signed-in users may create them, only the author may edit their own
    // report's content, and upvotes are the only field anyone else may
    // touch, one vote per user, enforced by requiring their own uid in
    // upvotedBy.
    match /reports/{reportId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && (request.resource.data.status == 'submitted'
                        || (request.resource.data.category == 'emergency'
                            && request.resource.data.status == 'in_progress'))
                    && request.resource.data.upvotes == 0;

      allow update: if request.auth != null && (
        // Report author can edit their own report's fields, but not status.
        (resource.data.createdBy == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['description', 'photoUrls', 'location'])) ||
        // Any signed-in user may toggle their own upvote.
        (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['upvotes', 'upvotedBy'])) ||
        // Status is moved by the admin dashboard (src/pages/Admin.jsx) or by
        // a response team marking a job complete (src/pages/TeamDashboard.jsx).
        // Both are client-side passcode gates, not a real role/permission
        // system (see context/AdminAuthContext.jsx, TeamAuthContext.jsx) --
        // so this rule can only check "is *some* authenticated Firebase
        // user", not "is a verified admin/team". Add custom claims + a real
        // rule check here before handling real citizen data.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      );

      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
    }

    // Response teams (src/pages/TeamDashboard.jsx, api/_dispatch-core.js).
    // Created from the admin dashboard (src/components/AddTeamForm.jsx,
    // src/lib/teams.js) or seeded directly via scripts/seedTeams.js -- never
    // created by a citizen or by a team itself. Team login
    // (context/TeamAuthContext.jsx) signs in anonymously purely to satisfy
    // `request.auth != null` here, then checks the passcode field itself
    // client-side -- same "no real per-identity access control" limitation
    // as the `status` field rule above and the create rule below, documented
    // rather than pretended away: any authenticated Firebase user (not just
    // a verified admin) can create or update a team through these rules.
    // Add custom claims + a real rule check here before handling this beyond
    // a prototype. The dispatch endpoint (a Vercel serverless function, not
    // a Firebase Cloud Function -- see api/_dispatch-core.js for why) uses
    // the Admin SDK, which bypasses these rules entirely, so it can always
    // assign jobs regardless.
    match /teams/{teamId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(
                         ['name', 'type', 'location', 'passcode', 'status', 'fcmToken', 'currentReportId'])
                    && request.resource.data.name is string
                    && request.resource.data.type is string
                    && request.resource.data.passcode is string
                    && request.resource.data.status == 'available'
                    && request.resource.data.fcmToken == null
                    && request.resource.data.currentReportId == null;
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status', 'location', 'fcmToken', 'currentReportId']);
      allow delete: if false;
    }
  }
}
