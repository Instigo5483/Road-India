rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    function validLocation(location) {
      return location.lat is number && location.lng is number &&
        location.lat >= -90 && location.lat <= 90 && location.lng >= -180 && location.lng <= 180;
    }

    function validContent(data) {
      return data.description is string && data.description.size() > 0 && data.description.size() <= 5000 &&
        data.photoUrls is list && data.photoUrls.size() <= 3 && validLocation(data.location);
    }

    match /reports/{reportId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.category == 'issue' &&
        request.resource.data.status == 'submitted' &&
        request.resource.data.upvotes == 0 &&
        request.resource.data.upvotedBy == [] &&
        request.resource.data.get('resolutionReactions', {}) == {} &&
        validContent(request.resource.data);

      // Prototype limitation: status/proof writes require authentication,
      // not a verified staff role. Replace this with admin custom claims
      // before collecting real citizen data.
      allow update: if request.auth != null && (
        (resource.data.status == 'resolved' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolutionReactions']) &&
          request.resource.data.resolutionReactions is map &&
          request.resource.data.resolutionReactions.diff(resource.data.get('resolutionReactions', {})).affectedKeys().hasOnly([request.auth.uid]) &&
          (!(request.auth.uid in request.resource.data.resolutionReactions) ||
            request.resource.data.resolutionReactions[request.auth.uid] in ['true', 'false'])) ||

        (resource.data.status != 'resolved' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt', 'resolutionProof']) &&
          request.resource.data.status == 'resolved' &&
          request.resource.data.resolvedAt == request.time &&
          request.resource.data.resolutionProof.photoUrls is list &&
          request.resource.data.resolutionProof.photoUrls.size() == 1 &&
          request.resource.data.resolutionProof.photoUrls[0] is string &&
          request.resource.data.resolutionProof.officer is string &&
          request.resource.data.resolutionProof.officer.size() > 0 &&
          request.resource.data.resolutionProof.notes is string &&
          request.resource.data.resolutionProof.notes.size() > 0 &&
          request.resource.data.resolutionProof.certified == true) ||

        (resource.data.status != 'resolved' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt']) &&
          request.resource.data.status in ['submitted', 'in_review', 'in_progress'] &&
          request.resource.data.resolvedAt == null) ||

        (resource.data.createdBy == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['createdByName', 'showCitizenBadge', 'showCivicRank']) &&
          request.resource.data.createdByName is string &&
          request.resource.data.showCitizenBadge is bool &&
          request.resource.data.showCivicRank is bool) ||

        (resource.data.createdBy == request.auth.uid &&
          resource.data.status in ['submitted', 'in_review'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['description', 'photoUrls', 'location']) &&
          validContent(request.resource.data)) ||

        (resource.data.createdBy == request.auth.uid &&
          resource.data.status == 'resolved' &&
          !('citizenFeedback' in resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['citizenFeedback']) &&
          request.resource.data.citizenFeedback.rating is int &&
          request.resource.data.citizenFeedback.rating >= 1 &&
          request.resource.data.citizenFeedback.rating <= 5 &&
          request.resource.data.citizenFeedback.confirmedResolved is bool &&
          request.resource.data.citizenFeedback.review is string &&
          request.resource.data.citizenFeedback.review.size() <= 2000) ||

        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'upvotedBy']) &&
          request.resource.data.upvotedBy is list &&
          request.resource.data.upvotedBy.toSet().size() == request.resource.data.upvotedBy.size() &&
          request.resource.data.upvotes >= 0 &&
          (
            (!(request.auth.uid in resource.data.get('upvotedBy', [])) &&
              request.resource.data.upvotedBy.toSet() == resource.data.get('upvotedBy', []).toSet().union([request.auth.uid].toSet()) &&
              request.resource.data.upvotes == resource.data.get('upvotes', 0) + 1) ||
            (request.auth.uid in resource.data.get('upvotedBy', []) &&
              request.resource.data.upvotedBy.toSet() == resource.data.get('upvotedBy', []).toSet().difference([request.auth.uid].toSet()) &&
              request.resource.data.upvotes == resource.data.get('upvotes', 0) - 1)
          ))
      );

      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
    }
    // No response-team collection access; retired routes/API are removed.
  }
}
