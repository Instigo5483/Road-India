# Firebase project config (Project settings -> General -> Your apps -> SDK setup and configuration)
# Copy this file to .env.local and fill in your own Firebase project's values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Report photos are stored inline as base64 in Firestore, not uploaded to
# Firebase Storage -- Storage requires the paid Blaze plan, which this
# project intentionally stays off of. VITE_FIREBASE_STORAGE_BUCKET above is
# unused by this app; it's only listed because it's part of the standard
# Firebase Web SDK config object.

# OpenAI API key for AI-assisted report triage (api/triage.js). This is a
# server-only secret -- do NOT prefix it with VITE_, or it would get bundled
# into the client-side JS and leaked to every visitor's browser.
# Get one at https://platform.openai.com/api-keys
# Optional: without it, triage falls back to a rule-based mock so the full
# citizen journey still works end-to-end with zero setup.
OPENAI_API_KEY=

# Passcode for the admin dashboard at /admin/login (src/context/AdminAuthContext.jsx).
# This is a lightweight client-side gate for the prototype, not real
# access control -- change it before sharing a live link publicly.
# Defaults to "roadindia-admin" if left unset.
VITE_ADMIN_PASSCODE=

# VAPID key for the response-team dashboard's push notifications (src/lib/messaging.js).
# Firebase Console -> Project settings -> Cloud Messaging -> Web configuration
# -> Generate key pair. Required for /team push notifications to work at all;
# without it, response teams can still use the dashboard, they just won't
# get notified of a new dispatch unless the app is already open.
VITE_FIREBASE_VAPID_KEY=

# Firebase Admin SDK service account key. Used server-side for two things:
#   1. Emergency dispatch (api/dispatch.js -- nearest-team matching + push
#      notification). Without it, emergency reports still file normally,
#      they just don't get dispatched to a response team.
#   2. Citizen login identity (api/login.js, api/_auth-core.js) -- mints a
#      Firebase custom auth token for a UID derived from the citizen's
#      Aadhaar/DigiLocker ID, so the same ID always signs into the same
#      account. Without it, login falls back to Firebase's plain
#      signInAnonymously(), which hands out a *different* identity on every
#      login -- the same citizen re-entering the same ID would not see
#      their existing profile or past reports.
# This is a server-only secret -- do NOT prefix it with VITE_.
#
# Get it: Firebase Console -> Project settings -> Service accounts ->
# Generate new private key (downloads a JSON file). Then base64-encode the
# whole file into a single line for this env var (newlines in the private
# key field break most .env / dashboard UIs otherwise):
#   macOS/Linux: base64 -i serviceAccountKey.json | tr -d '\n'
#   Windows (PowerShell): [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccountKey.json"))
FIREBASE_SERVICE_ACCOUNT=
